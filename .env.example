NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/carpooling_platform
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_ME_TO_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Used only by `npm run create-admin --workspace server`.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email (Nodemailer) configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@carpooling.local

# Razorpay Payment Gateway (Optional - falls back to mock payment provider)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
